[ ca ]
default_ca = ca_racine
[ ca_racine ]
dir = ./racine
database = $dir/index.txt
new_certs_dir = $dir/newcerts
serial = $dir/serial
crlnumber = $dir/crlnumber
certificate = $dir/racine.crt
private_key = $dir/racine.key
default_md = sha384
default_crl_days = 30
policy = politique_souple
copy_extensions = none
[ politique_souple ]
countryName = optional
organizationName = optional
commonName = supplied

[ ext_inter ]
basicConstraints = critical,CA:TRUE,pathlen:0
keyUsage = critical,keyCertSign,cRLSign
nameConstraints = critical,@contraintes_noms
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[contraintes_noms]
permitted;DNS.1 = .tp.local
permitted;DNS.2 = tp.local
permitted;email.1 = tp.local
